# Configuration NON secrète de prod, lue par scripts/deploy.sh (remplace les variables GitHub de `prod`, D36).
# Secrets (TURNSTILE_SECRET, ALERT_EMAIL, CLOUDFLARE_API_TOKEN) : ~/.config/optrail/private.env, jamais ici.
DATA_VERSION=bdtopo-wfs-2026-10d
