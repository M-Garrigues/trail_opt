# Configuration NON secrète de prod, lue par scripts/deploy.sh (remplace les variables GitHub de `prod`, D36).
# Secrets (TURNSTILE_SECRET, ALERT_EMAIL, CLOUDFLARE_API_TOKEN) : ~/.config/optrail/private.env, jamais ici.
DATA_VERSION=bdtopo-wfs-2026-10e.1
# Origine des dalles : zip = embarquées dans le zip Lambda (≤ ~200 Mo, couverture pilote) ;
# s3 = lues à la demande depuis s3://<artefacts>/tiles/$DATA_VERSION/ vers /tmp (D43, France entière).
# s3 exige la boundary à jour (infra/README.md § Dalles sur S3). Retour arrière : zip + redéployer.
TILES_SOURCE=s3
# Après le premier apply : domaine de la sortie `url` (dxxxx.cloudfront.net), pour Turnstile.
CLOUDFRONT_HOSTNAME=d2lmxvsw7jmodz.cloudfront.net
ENABLE_CUSTOM_DOMAIN=true
CLOUDFLARE_ZONE_ID=53e7c2faaa34f163394e2cc396e86378
# -1 = pas de concurrence réservée (quota du compte = 10).
LAMBDA_RESERVED_CONCURRENCY=-1
